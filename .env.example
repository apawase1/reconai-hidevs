GOOGLE_API_KEY=your_gemini_api_key_here

# Google Sheets sync is currently dormant (parked as a future integration —
# see the note at the top of README.md), so there's no sheet ID to set here.

# Optional — override the default model for all 3 agents / extraction calls.
# gemini-2.5-flash is deprecated for new users (404 NOT_FOUND) — use gemini-3.5-flash.
RECONAI_MODEL=gemini-3.5-flash
EXTRACTION_MODEL=gemini-3.5-flash

# Optional — override OAuth file locations (defaults shown).
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
